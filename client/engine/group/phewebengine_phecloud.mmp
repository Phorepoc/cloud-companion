// Copyright The Phorepoc Authors
// SPDX-License-Identifier: Apache-2.0
//
// phewebengine_phecloud.mmp -- the Phecloud web-engine plug-in for the Phorepoc browser: an ECom implementation (interface
// 0xE7016B01) of phewebengine.h over the portable phc client core and its mbedTLS 1.3 adapter. Apache-2.0; links only
// permissive code (mbedTLS, libpng, libjpeg) and the Open C libc.
//
// Not self-contained on purpose: the seam header (phewebengine repo), the mbedTLS 3.6 headers and archive (with the config
// header selected by -DMBEDTLS_CONFIG_FILE) and the libpng / libjpeg headers and archives come from the build's include and
// link lines (the Phorepoc build registry: emitter/components.py, key phewebengine_phecloud).
TARGET			phewebengine_phecloud.dll
TARGETTYPE		plugin
UID				0x10009D8D 0xE7016B21
// user capabilities only; >= the host browser's
CAPABILITY		NetworkServices LocalServices ReadUserData WriteUserData UserEnvironment
VENDORID		0
EPOCALLOWDLLDATA

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
USERINCLUDE		..
USERINCLUDE		../..

SOURCEPATH		..
SOURCE			phengine_phc.c
SOURCE			phewebengine_phecloud.cpp
SOURCEPATH		../..
SOURCE			phc.c
SOURCE			phc_cbor.c
SOURCE			phc_sha256.c
SOURCE			phc_mbedtls.c

SOURCEPATH		..
START RESOURCE	phewebengine_phecloud.rss
TARGET			phewebengine_phecloud.rsc
END

LIBRARY			euser.lib efsrv.lib ecom.lib
LIBRARY			libc.lib libm.lib libpthread.lib libz.lib
UNPAGED
SMPSAFE
