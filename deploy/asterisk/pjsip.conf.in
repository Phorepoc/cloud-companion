; phecloud-asterisk: written on the first start of the compose profile "asterisk" (docs/messaging.md). Yours to edit: add phones by
; copying a 201 block, then `docker compose exec asterisk asterisk -rx "module reload res_pjsip.so"`.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
@EXTERNAL@

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
@EXTERNAL@

[phone](!)
type=endpoint
context=calls
message_context=messages
disallow=all
allow=g722,ulaw,alaw
direct_media=no
rewrite_contact=yes
rtp_symmetric=yes
force_rport=yes

[aor](!)
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=60

; Cloud Companion: add it in Connections as a SIP service (server "asterisk", user "cloud-companion", this password)
[cloud-companion](phone)
auth=cloud-companion
aors=cloud-companion
[cloud-companion]
type=auth
auth_type=userpass
username=cloud-companion
password=@CC_SECRET@
[cloud-companion](aor)

[201](phone)
auth=201
aors=201
[201]
type=auth
auth_type=userpass
username=201
password=@P201@
[201](aor)

[202](phone)
auth=202
aors=202
[202]
type=auth
auth_type=userpass
username=202
password=@P202@
[202](aor)
