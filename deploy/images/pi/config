# pi-gen settings for the Cloud Companion board image (build.sh): Raspberry Pi OS Lite 64-bit (trixie) plus stage-cloud.
IMG_NAME=cloud-companion
PI_GEN_RELEASE="Cloud Companion"
RELEASE=trixie
TARGET_HOSTNAME=cloud-companion
LOCALE_DEFAULT=en_GB.UTF-8
KEYBOARD_KEYMAP=gb
KEYBOARD_LAYOUT="English (UK)"
TIMEZONE_DEFAULT=Etc/UTC
# no login on the board: it is run from the setup page and Cloud Companion. Raspberry Pi Imager can still add a user and SSH.
FIRST_USER_NAME=cloud
DISABLE_FIRST_BOOT_USER_RENAME=1
ENABLE_SSH=0
STAGE_LIST="stage0 stage1 stage2 stage-cloud"
DEPLOY_COMPRESSION=xz
